          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(re_lab_tool_duration_seconds_bucket[5m])) by (le, tool))",
          "legendFormat": "p95 {{tool}}",
          "refId": "A"
        }
      ]
    },
    {
