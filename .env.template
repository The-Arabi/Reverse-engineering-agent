# Environment Variables for Reverse Engineering Research Agent Platform
# Copy this file to .env and fill in the values

# =============================================================================
# LLM Provider (REQUIRED — agents will fail without API key)
# Choose one: openai, google, anthropic, openrouter, nvidia_nim, ollama
# =============================================================================
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# LLM_BASE_URL=              # Only needed for custom endpoints (Ollama, LM Studio, etc.)
# LLM_MODEL=                 # Only needed to override the provider's default model

# --- Provider: OpenAI ---
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# --- Provider: Google AI Studio (Gemini) ---
# Get key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...

# --- Provider: Anthropic Claude ---
# Get key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# --- Provider: OpenRouter (100+ models) ---
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# --- Provider: NVIDIA NIM ---
# Get key: https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-...

# --- Provider: Ollama (Local, no key needed) ---
# Install: https://ollama.com/download
# Pull model: ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# Embedding Configuration
# =============================================================================
# Primary provider: "gemini", "jina", or "tfidf" (local, no API key needed)
EMBEDDING_PROVIDER=tfidf
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=text-embedding-004
JINA_API_KEY=your-jina-api-key-here
JINA_MODEL=jina-embeddings-v3

# =============================================================================
# Self-Critique Configuration
# =============================================================================
CRITIQUE_ENABLED=true
CRITIQUE_CONFIDENCE_THRESHOLD=0.6

# =============================================================================
# Knowledge Extraction Configuration
# =============================================================================
KNOWLEDGE_EXTRACTION_ENABLED=true

# =============================================================================
# Multi-Agent Debate Configuration
# =============================================================================
DEBATE_ENABLED=true
DEBATE_MAX_ROUNDS=3
DEBATE_CONFIDENCE_THRESHOLD=0.5
DEBATE_MIN_PARTICIPANTS=2

# =============================================================================
# Token Budget & Rate Limiting Configuration
# =============================================================================
TOKEN_BUDGET_ENABLED=true
TOKEN_GLOBAL_LIMIT=1000000
TOKEN_AGENT_LIMIT=100000
TOKEN_MISSION_LIMIT=500000
TOKEN_GLOBAL_RPM=60
TOKEN_AGENT_RPM=10
TOKEN_WARNING_THRESHOLD=0.8

# =============================================================================
# Confidence Scoring Configuration
# =============================================================================
CONFIDENCE_TOOL_WEIGHT=0.3
CONFIDENCE_LLM_WEIGHT=0.4
CONFIDENCE_CRITIQUE_WEIGHT=0.3
CONFIDENCE_MIN_THRESHOLD=0.3
REANALYZE_ENABLED=true
REANALYZE_MAX_ATTEMPTS=2

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# =============================================================================
# Dashboard Configuration
# =============================================================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=False

# =============================================================================
# Monitoring & Observability
# =============================================================================
MONITORING_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
STRUCTURED_LOGGING=false

PROMETHEUS_ENABLED=true
PROMETHEUS_SCRAPE_INTERVAL=15s

GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
REVERSE_ENGINEERING_ENV=development
